@model List<UserWithRolesViewModel>
@{
    ViewData["Title"] = "Users";
}

<h2 class="mb-3">All Users</h2>

<a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-sm btn-primary mb-3">Create New User</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Display Name</th>
            <th>Roles</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.DisplayName</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <form asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

